# ==========================================
# HospitalX Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MySQL)
# Example: mysql://username:password@localhost:3306/hospitalx
DATABASE_URL=mysql://hospitalx_user:hospitalx_password@localhost:3306/hospitalx_db

# Security & Session Authentication
# Strong cryptographic random string (min 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=24h

# CORS Configuration (Frontend Origin)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Hospital Default Context
DEFAULT_HOSPITAL_CODE=HOSP-CENTRAL-01
DEFAULT_HOSPITAL_NAME=HospitalX Central Memorial Hospital
